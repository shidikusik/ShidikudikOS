# Пакеты, попадающие в chroot (то есть в саму ОС на ISO).

# --- база ---
live-boot
live-config
systemd-sysv
sudo
locales
console-setup
network-manager
pipewire
pipewire-pulse
wireplumber

# --- рантайм графического стека (Wayland/wlroots) ---
# Mesa обязательна: без DRI-драйверов wlroots не создаст GLES-рендерер
# и упадёт в программный pixman (тормоза и артефакты, особенно в VM)
libgl1-mesa-dri
libegl-mesa0
libegl1
libgles2
libgbm1
libwlroots-0.18
libwayland-server0
libwayland-client0
libxkbcommon0
libinput10
seatd
xwayland
libgtk-3-0
libgtk-layer-shell0
libglib2.0-0
libpam0g
libsystemd0
adwaita-icon-theme
fonts-dejavu
xdg-desktop-portal
xdg-desktop-portal-wlr

# --- пользовательские приложения ---
foot
firefox-esr
nautilus
libvte-2.91-0

# --- инсталлер shidik-install ---
parted
dosfstools
rsync
efibootmgr
grub-common
grub2-common
grub-pc-bin
grub-efi-amd64-bin

# --- инструменты сборки: нужны chroot-хуку, который компилирует
#     ShidikDM/ShidikDE из исходников; при желании можно удалить их
#     обратным хуком после сборки ---
gcc
make
pkg-config
libpam0g-dev
libwlroots-0.18-dev
libwayland-dev
libxkbcommon-dev
wayland-protocols
libgtk-3-dev
libgtk-layer-shell-dev
libsystemd-dev
libvte-2.91-dev
