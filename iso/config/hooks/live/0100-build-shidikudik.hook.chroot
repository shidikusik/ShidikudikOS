#!/bin/sh
# Chroot-хук live-build: выполняется ВНУТРИ будущей системы на этапе
# `lb build`. Компилирует ShidikDM и ShidikDE из исходников, которые
# build.sh скопировал в /opt/shidikudik/src (через includes.chroot),
# устанавливает их и включает автозапуск ShidikDM.
set -e

echo "== ShidikudikOS: сборка ShidikDM/ShidikDE =="
SRC=/opt/shidikudik/src

for component in shidikdm shidikwm shidikpanel shidiklaunch shidiksession \
                 shidikgreet shidikterm shidikcontrol; do
    echo "-- сборка $component"
    make -C "$SRC/$component" clean all install
done

# Брендинг: логотип и обои (нужны greeter'у и Shidik-Control)
install -Dm644 /opt/shidikudik/assets/logo.svg \
    /usr/share/shidikudik/logo.svg
install -Dm644 /opt/shidikudik/assets/wallpaper.png \
    /usr/share/shidikudik/wallpaper.png
install -Dm644 /opt/shidikudik/assets/wallpaper-blur.png \
    /usr/share/shidikudik/wallpaper-blur.png

# Инсталлер: бинарь + пункт в меню приложений
install -Dm755 /opt/shidikudik/installer/shidik-install \
    /usr/local/bin/shidik-install
install -Dm644 /opt/shidikudik/installer/shidikudik-installer.desktop \
    /usr/share/applications/shidikudik-installer.desktop

# Live-пользователь создаётся статически: полагаться на live-config
# нельзя — проверено на реальной сборке, что с нестандартным DM его
# user-setup может не отработать (вход был бы невозможен).
if ! id shidik >/dev/null 2>&1; then
    useradd -m -s /bin/bash -G sudo,audio,video shidik
    # netdev есть в Debian, но не в Ubuntu — добавляем только если группа
    # существует (несуществующая группа валит useradd целиком)
    getent group netdev >/dev/null && usermod -aG netdev shidik
fi
echo 'shidik:live' | chpasswd

# systemd: наш DM становится display-manager'ом системы
install -Dm644 /opt/shidikudik/systemd/shidikdm.service \
    /etc/systemd/system/shidikdm.service
systemctl enable shidikdm.service
systemctl set-default graphical.target

echo "== ShidikudikOS: готово =="
