# /etc/systemd/system/shidikdm.service (или /usr/lib/systemd/system/)
# ShidikDM занимает tty1 вместо getty, как это делают greetd/ly.
# Включение: systemctl enable shidikdm  (Alias делает его
# display-manager.service — стандартной точкой входа Debian в GUI).

[Unit]
Description=ShidikudikOS Display Manager (ShidikDM)
Documentation=https://github.com/shidikusik/ShidikudikOS
Conflicts=getty@tty1.service
After=systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service
After=systemd-logind.service

[Service]
Type=idle
ExecStart=/usr/local/bin/shidikdm
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=always
RestartSec=1

[Install]
Alias=display-manager.service
WantedBy=graphical.target
