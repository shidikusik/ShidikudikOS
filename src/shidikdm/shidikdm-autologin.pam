# PAM-конфигурация автовхода ShidikDM (/etc/pam.d/shidikdm-autologin).
#
# Стадия auth заменена на pam_permit: пароль не спрашивается. Применяется
# только когда существует /etc/shidikudik/autologin (live-режим ISO);
# установленная на диск система этот файл не получает — там обычный вход.
#
# Остальные стадии стандартные: проверка аккаунта и полноценная сессия
# через pam_systemd (logind + XDG_RUNTIME_DIR).

auth      required   pam_permit.so

@include  common-account

session   required   pam_loginuid.so
session   optional   pam_keyinit.so force revoke
@include  common-session

@include  common-password
